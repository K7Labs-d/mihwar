PORT=3000
HOST=127.0.0.1
AUTH_ORIGIN=http://localhost:3000
# SQLite path is relative to the project. Keep data on persistent storage when hosting.
AUTH_DB_PATH=data/clients.sqlite
# Required for production login codes. Verify the sender domain with Resend first.
RESEND_API_KEY=
LOGIN_EMAIL_FROM=login@your-verified-domain.example
